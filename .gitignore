.DS_Store
node_modules/

# Build output. .next-check is the scratch dist so a build never kills the
# instance that is currently serving you (see next.config.ts).
.next/
.next-check/
out/
*.tsbuildinfo

# Your config and your data. Both are YOURS: an update never touches them.
# The tracked default lives in hub.config.example.json.
hub.config.json
data/
user/
*.db
*.db-journal
*.db-wal
*.db-shm

# The real denylist is machine local and is never committed: publishing your
# content scanner must never publish the list of things you are keeping out.
.githooks/denylist.local

# Agent worktrees. The tracked half of .claude/ is the skills that ship with the
# hub; a worktree created under it is a whole second checkout, and `git add
# .claude` in the main checkout would otherwise commit one.
.claude/worktrees/

# Environment
.env
.env.*

# Next generated ambient types
next-env.d.ts
